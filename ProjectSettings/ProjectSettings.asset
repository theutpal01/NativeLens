<ProjectSettings>
  <setting name="productName" value="NativeLens" />
  <setting name="companyName" value="NativeLens Team" />
  <setting name="defaultScreenWidth" value="1080" />
  <setting name="defaultScreenHeight" value="1920" />
  <setting name="defaultScreenOrientation" value="Portrait" />
